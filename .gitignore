# Constitution: card images and generated output are never committed.
# This file is the safety net; review is the control.

# Source card assets (external — Drive today, object store later).
# Anchored with a leading slash so they match ONLY at the repository root. Unanchored,
# `assets/` also matched src/marchamp/assets/ and silently excluded that whole source
# package from every commit — local tests passed, CI could not import it.
/assets/
/cards/
/card_directory/
*.tif
*.tiff
*.psd

# Generated output and derived renditions (root-anchored, same reason as above)
/out/
/output/
/dist/
/build/
*.pdf
.cache/
.renditions/

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json
client_secret*.json
token.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/
.next/
.turbo/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Claude Code local overrides
.claude/settings.local.json
# Agent worktrees are checkouts of this repository, not content of it. Committing one
# embeds a git repo inside the repo and git only warns about it.
.claude/worktrees/
